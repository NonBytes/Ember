<?xml version="1.0" encoding="utf-8"?>
<!-- Dark hero gradient for list cards (24dp corners). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="315"
        android:startColor="#FF1A181D"
        android:centerColor="#FF261B19"
        android:endColor="#FF381C12" />
    <stroke
        android:width="1dp"
        android:color="#18FFFFFF" />
    <corners android:radius="24dp" />
</shape>
