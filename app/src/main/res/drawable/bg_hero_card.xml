<?xml version="1.0" encoding="utf-8"?>
<!-- Dark hero gradient for the featured server card (reference design). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="315"
        android:startColor="#FF1C191E"
        android:centerColor="#FF2B1C18"
        android:endColor="#FF4A1D0E" />
    <stroke
        android:width="1dp"
        android:color="#1CFFFFFF" />
    <corners android:radius="28dp" />
</shape>
